# Локальный список запретных имён для стража: сам список публикации не подлежит.
# Формат — по токену на строку, пустые строки и строки с # игнорируются.
# Без него проверка на чужие имена пропускается с уведомлением, а не молча.
.denylist

# Байт-код Python: производное от стражей, пересобирается сам.
__pycache__/
*.pyc

# Временные файлы редакторов и системы
*~
*.bak
*.orig
*.tmp
.DS_Store
Thumbs.db
