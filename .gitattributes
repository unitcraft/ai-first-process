# Переводы строк фиксируются здесь, а не настройкой машины.
#
# ЗАЧЕМ. На машине с core.autocrlf=true git подменяет LF на CRLF при выгрузке, и скрипт
# с CRLF на Linux не запускается вовсе: интерпретатор читает первую строку как
# «/usr/bin/env bash\r» и отвечает «bad interpreter». Репозиторий обещает переносимость,
# поэтому перевод строки задаётся файлом репозитория и не зависит от того, чья машина
# делает клон.
*.sh text eol=lf

# Стражи — по той же причине: их запускают и на Linux, а различие в переводе строки
# создаёт дифф на ровном месте при правке с разных машин.
*.py text eol=lf

# Документы — тоже LF: содержимое сравнивается и правится инструментами, которым CRLF
# добавляет шум в дифф на ровном месте.
*.md text eol=lf

# Git-хук, который ставится скриптом, живёт в .git/hooks и сюда не попадает — его
# перевод строки задаёт сам скрипт установки.
